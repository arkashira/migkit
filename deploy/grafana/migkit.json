{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource",
     "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "title": "migkit",
  "uid": "migkit",
  "description": "What migkit measures on every hop - the verdicts, the copy, the change tail and stream, the verify, every table on both sides, the cutover - from its /metrics endpoint (migkit report --serve). Shipped with deploy/prometheus-alerts.yml.",
  "tags": ["migkit", "migration"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "hop", "label": "hop", "type": "query",
       "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
       "query": "label_values(migkit_verdict, hop)",
       "refresh": 2, "multi": true, "includeAll": true}
    ]
  },
  "panels": [
    {"id": 1, "type": "table", "title": "Verdict of the last check",
     "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"refId": "A", "expr": "migkit_verdict{hop=~\"$hop\"} == 1", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "engine": true, "instance": true, "job": true}}}]},
    {"id": 2, "type": "bargauge", "title": "Answers the same, each check",
     "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"refId": "A", "expr": "sum by (hop, check) (migkit_check_answers{hop=~\"$hop\",status=\"ok\"}) / sum by (hop, check) (migkit_check_answers{hop=~\"$hop\"})", "legendFormat": "{{hop}} {{check}}"}]},
    {"id": 3, "type": "stat", "title": "Since the last check",
     "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"refId": "A", "expr": "migkit_last_check_age_seconds{hop=~\"$hop\"}", "legendFormat": "{{hop}}"}]},
    {"id": 4, "type": "timeseries", "title": "Change tail behind the source",
     "gridPos": {"x": 0, "y": 5, "w": 12, "h": 7},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "migkit_tail_behind_seconds{hop=~\"$hop\"}", "legendFormat": "tail {{hop}} {{db}}"},
       {"refId": "B", "expr": "migkit_stream_behind_source_seconds{hop=~\"$hop\"}", "legendFormat": "stream {{hop}}"}]},
    {"id": 5, "type": "timeseries", "title": "Log not yet carried",
     "gridPos": {"x": 12, "y": 5, "w": 12, "h": 7},
     "fieldConfig": {"defaults": {"unit": "bytes"}},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "migkit_follow_behind_bytes{hop=~\"$hop\"}", "legendFormat": "behind {{hop}} {{db}}"},
       {"refId": "B", "expr": "migkit_follow_held_bytes{hop=~\"$hop\"}", "legendFormat": "held {{hop}} {{db}}"},
       {"refId": "C", "expr": "migkit_tail_source_held_bytes{hop=~\"$hop\"}", "legendFormat": "source holds {{hop}} {{db}}"}]},
    {"id": 6, "type": "timeseries", "title": "Changes read and applied",
     "gridPos": {"x": 0, "y": 12, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "rate(migkit_tail_changes_applied_total{hop=~\"$hop\"}[5m])", "legendFormat": "tail applied/s {{hop}} {{db}}"},
       {"refId": "B", "expr": "rate(migkit_stream_events_seen_total{hop=~\"$hop\"}[5m])", "legendFormat": "stream read/s {{hop}}"}]},
    {"id": 7, "type": "stat", "title": "Change stream parts running",
     "gridPos": {"x": 12, "y": 12, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "migkit_stream_running{hop=~\"$hop\"}", "legendFormat": "{{hop}} {{part}}"},
       {"refId": "B", "expr": "migkit_stream_connected{hop=~\"$hop\"}", "legendFormat": "{{hop}} connected"},
       {"refId": "C", "expr": "migkit_stream_queue_remaining{hop=~\"$hop\"}", "legendFormat": "{{hop}} queue room"},
       {"refId": "D", "expr": "migkit_stream_snapshot_tables_remaining{hop=~\"$hop\"}", "legendFormat": "{{hop}} first read: tables left"}]},
    {"id": 8, "type": "bargauge", "title": "Copy: tables done",
     "gridPos": {"x": 0, "y": 19, "w": 8, "h": 7},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"refId": "A", "expr": "migkit_move_tables_done{hop=~\"$hop\"} / migkit_move_tables{hop=~\"$hop\"}", "legendFormat": "{{hop}} {{db}}"}]},
    {"id": 9, "type": "timeseries", "title": "Copy: rows carried per table",
     "gridPos": {"x": 8, "y": 19, "w": 8, "h": 7},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"refId": "A", "expr": "migkit_move_rows{hop=~\"$hop\"}", "legendFormat": "{{db}} {{table}}"}]},
    {"id": 10, "type": "bargauge", "title": "Copy: rows a second, last copy by each way",
     "gridPos": {"x": 16, "y": 19, "w": 8, "h": 7},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "migkit_copy_way_rows_per_second{hop=~\"$hop\"} * on (hop, way_id) group_left (way) migkit_way_info{hop=~\"$hop\"}", "legendFormat": "{{hop}} {{way}}"},
       {"refId": "B", "expr": "migkit_copy_way_seconds{hop=~\"$hop\"} * on (hop, way_id) group_left (way) migkit_way_info{hop=~\"$hop\"}", "legendFormat": "{{hop}} {{way}} seconds"}]},
    {"id": 11, "type": "bargauge", "title": "Seconds each check took",
     "gridPos": {"x": 0, "y": 26, "w": 8, "h": 7},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"refId": "A", "expr": "migkit_check_seconds{hop=~\"$hop\"}", "legendFormat": "{{db}} {{check}}"}]},
    {"id": 12, "type": "timeseries", "title": "Verify in progress: rows proved equal",
     "gridPos": {"x": 8, "y": 26, "w": 8, "h": 7},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "migkit_verify_rows_done{hop=~\"$hop\"}", "legendFormat": "{{db}} {{table}}"},
       {"refId": "B", "expr": "migkit_verify_ranges_done{hop=~\"$hop\"}", "legendFormat": "{{db}} {{table}} ranges"}]},
    {"id": 13, "type": "table", "title": "Tables not the same on both sides",
     "gridPos": {"x": 16, "y": 26, "w": 8, "h": 7},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "migkit_table_same{hop=~\"$hop\"} == 0", "format": "table", "instant": true},
       {"refId": "B", "expr": "migkit_table_rows{hop=~\"$hop\"}", "format": "table", "instant": true}]},
    {"id": 14, "type": "stat", "title": "Cutover: write outage measured",
     "gridPos": {"x": 0, "y": 33, "w": 8, "h": 6},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "migkit_cutover_outage_seconds{hop=~\"$hop\"}", "legendFormat": "{{hop}}"},
       {"refId": "B", "expr": "migkit_cutover_running{hop=~\"$hop\"}", "legendFormat": "{{hop}} under way"}]},
    {"id": 15, "type": "bargauge", "title": "Cutover: seconds each phase took",
     "gridPos": {"x": 8, "y": 33, "w": 8, "h": 6},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"refId": "A", "expr": "migkit_cutover_phase_seconds{hop=~\"$hop\"}", "legendFormat": "{{hop}} {{phase}}"}]},
    {"id": 16, "type": "stat", "title": "What the source keeps for the tail",
     "gridPos": {"x": 16, "y": 33, "w": 8, "h": 6},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"refId": "A", "expr": "migkit_tail_retention_margin_seconds{hop=~\"$hop\"}", "legendFormat": "{{hop}} {{db}} seconds"},
       {"refId": "B", "expr": "migkit_tail_retention_margin_bytes{hop=~\"$hop\"}", "legendFormat": "{{hop}} {{db}} bytes"}]}
  ]
}
