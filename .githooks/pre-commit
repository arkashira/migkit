#!/usr/bin/env bash
# migkit is meant to be shared: no real endpoint, IP, account id or credential
# may enter the source. Real values belong in conf/hops.yaml (gitignored).
# enable once per clone:  git config core.hooksPath .githooks
py=".venv/bin/python"; [ -x "$py" ] || py=python3
"$py" tools/check_no_secrets.py --staged || {
  echo
  echo "commit blocked. Move those values into conf/hops.yaml (gitignored),"
  echo "or use a placeholder (example.com / 10.0.0.x / CHANGE_ME) in docs."
  exit 1
}

# the manual and the site are written from the code (tools/gen_docs.py): a
# page behind it is written again here and the commit stopped, so the pages
# go in with the change that moved them. A checkout without its own
# environment uses the one beside these hooks.
docs=".venv/bin/python"
[ -x "$docs" ] || docs="$(dirname "$0")/../.venv/bin/python"
[ -x "$docs" ] || docs=python3
"$docs" tools/gen_docs.py --check >/dev/null 2>&1
case $? in
  0) ;;
  3)
    "$docs" tools/gen_docs.py
    echo
    echo "commit stopped: the manual was behind the code and is written"
    echo "again. Add the pages (git add docs README.md) and commit again."
    exit 1 ;;
  *)
    echo "the manual could not be checked against the code here"
    echo "(run: python tools/gen_docs.py --check); the commit goes on." ;;
esac

# where everything is (tools/gen_codemap.py): the map kept in the repo is
# written again and the commit stopped when it is behind, as the manual's
# pages are; every symbol's file:line is written on this machine for the
# next session to read instead of searching (.codemap/, gitignored), and so
# is a tags index where universal-ctags is installed
"$docs" tools/gen_codemap.py --check >/dev/null 2>&1
case $? in
  0) "$docs" tools/gen_codemap.py --symbols >/dev/null 2>&1 ;;
  3)
    "$docs" tools/gen_codemap.py >/dev/null
    echo
    echo "commit stopped: the code map was behind the code and is written"
    echo "again. Add it (git add docs/agents/CODEMAP.md) and commit again."
    exit 1 ;;
  *) echo "the code map could not be checked here; the commit goes on." ;;
esac
for ct in ctags /opt/homebrew/bin/ctags /usr/local/bin/ctags; do
  if "$ct" --version 2>/dev/null | grep -q "Universal Ctags"; then
    "$ct" -R --languages=Python -f tags migkit tools tests 2>/dev/null || true
    break
  fi
done
